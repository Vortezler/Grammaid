{
  "name": "grammaid",
  "version": "1.3.0",
  "description": "Offline writing assistant with local language packs and automatic corrections for Waterfox",
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "npm run build && node scripts/dev.mjs",
    "lint": "eslint . && tsc --noEmit",
    "build:wordnet": "node scripts/build-wordnet.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "package": "npm run build && node scripts/package-xpi.mjs",
    "harness": "node scripts/harness.mjs",
    "verify:translation-packs": "node scripts/verify-translation-packs.mjs",
    "smoke:translation": "node scripts/translation-smoke.mjs",
    "smoke:speech": "node scripts/speech-smoke.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "^4.3.2",
    "compromise": "^14.20.0",
    "harper.js": "^3.0.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wordnet-db": "^3.1.14"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
